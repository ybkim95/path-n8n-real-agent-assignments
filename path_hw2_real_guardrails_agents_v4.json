    {
      "parameters": {
        "jsCode": "const output = $input.first().json.output || JSON.stringify($input.first().json);\nconst needs_human_review = /HUMAN_REVIEW|unsafe|blocked|guardrail|ignore all/i.test(output);\nreturn [{\n  json: {\n    agent_output: output,\n    needs_human_review,\n    route_reason: needs_human_review ? \"Guardrail or triage requested human review.\" : \"Low-risk path.\"\n  }\n}];"
      },
      "id": "hw2-real-route",
      "name": "Deterministic Route Parser",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        280,
        140
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "hw2-real-if-condition",
              "leftValue": "={{ $json.needs_human_review }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "hw2-real-if",
      "name": "Needs Human Review?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        540,
        140
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nreturn [{\n  json: {\n    route: \"human_review\",\n    action_taken: \"none\",\n    reviewer_packet: item,\n    note: \"A human must approve before any user-facing response.\"\n  }\n}];"
      },
      "id": "hw2-real-human",
      "name": "Human Review Packet",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        40
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nreturn [{\n  json: {\n    route: \"safe_auto_draft\",\n    action_taken: \"draft_created_only\",\n    sent_external_message: false,\n    draft: item.agent_output\n  }\n}];"
      },
      "id": "hw2-real-action",
      "name": "Deterministic Action Stub",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        260
      ]
    },
    {
      "parameters": {
        "mode": "append"
      },
      "id": "hw2-real-merge",
      "name": "Merge Safety Routes",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        1060,
        140
      ]
    },
    {
      "parameters": {
        "jsCode": "const result = $input.first().json;\nreturn [{\n  json: {\n    assignment: \"HW2 REAL - Guardrails Around Agents\",\n    result,\n    safety_design: [\n      \"Input Guardrails before the agent\",\n      \"Triage Agent with Think Tool\",\n      \"Output Guardrails after the agent\",\n      \"Deterministic route parser\",\n      \"Human-review path\",\n      \"No external action is actually sent\"\n    ],\n    reflection_questions: [\n      \"Which guardrail triggered or should have triggered?\",\n      \"Why is the action node deterministic?\",\n      \"What should a human reviewer see before approving?\"\n    ]\n  }\n}];"
      },
      "id": "hw2-real-final",
      "name": "Final Audit Packet - submit this",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        140
      ]
    }
