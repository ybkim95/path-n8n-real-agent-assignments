    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "hw1-real-if-condition",
              "leftValue": "={{ $json.output }}",
              "rightValue": "REVISE",
              "operator": {
                "type": "string",
                "operation": "contains"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "hw1-real-if",
      "name": "Needs Revision?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        800,
        140
      ]
    },
    {
      "parameters": {
        "jsCode": "const critic = $input.first().json.output || \"\";\nconst draft = $(\"Build Critic Prompt\").first().json.draft;\nreturn [{\n  json: {\n    critic,\n    draft,\n    chatInput: [\n      \"Revise the digest using the critic feedback.\",\n      \"Keep the same topic and audience.\",\n      \"Critic feedback:\",\n      critic,\n      \"\",\n      \"Original draft:\",\n      draft\n    ].join(\"\\n\")\n  }\n}];"
      },
      "id": "hw1-real-revision-prompt",
      "name": "Build Revision Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1060,
        40
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.chatInput }}",
        "options": {
          "systemMessage": "You are the Revision Agent. Improve the draft based only on critic feedback. Keep it safe, plain, and useful."
        }
      },
      "id": "hw1-real-revision",
      "name": "Revision Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
