      },
      "id": "hw1-real-revision-model",
      "name": "Chat Model - Revision",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        1300,
        270
      ]
    },
    {
      "parameters": {},
      "id": "hw1-real-revision-think",
      "name": "Think Tool - Revision",
      "type": "@n8n/n8n-nodes-langchain.toolThink",
      "typeVersion": 1,
      "position": [
        1440,
        270
      ]
    },
    {
      "parameters": {
        "jsCode": "const critic = $input.first().json.output || \"\";\nconst draft = $(\"Build Critic Prompt\").first().json.draft;\nreturn [{ json: { final_draft: draft, critic_review: critic, revision_made: false } }];"
      },
      "id": "hw1-real-approved",
      "name": "Approved Draft Packet",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1060,
        260
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nreturn [{\n  json: {\n    assignment: \"HW1 REAL - AI Agent Team and Tools\",\n    final_output: item.output || item.final_draft,\n    revision_made: Boolean(item.output),\n    required_agent_nodes: [\"Researcher Agent\", \"Writer Agent\", \"Critic Agent\", \"Revision Agent\"],\n    required_tools: [\"Wikipedia Tool - Researcher\", \"Think Tools\", \"Calculator Tool - Critic\"],\n    reflection_questions: [\n      \"Which agent used a tool, and why?\",\n      \"Which node was deterministic, and why was that better than AI?\",\n      \"What was passed from Researcher to Writer?\"\n    ]\n  }\n}];"
      },
      "id": "hw1-real-final",
      "name": "Final Packet - submit this",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1600,
        140
      ]
    }
